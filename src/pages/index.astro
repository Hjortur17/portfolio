---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import Panel from '../components/Panel.astro';
import StatTile from '../components/StatTile.astro';
import SheetRow from '../components/SheetRow.astro';
import ColorBar from '../components/ColorBar.astro';
import PixelImage from '../components/PixelImage.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LoadingQueue from '../components/LoadingQueue.astro';
import { site, socials, tools } from '../data/site';
import avatar from '../assets/me.webp';

const allProjects = await getCollection('projects');

/* Anything unfinished belongs in the queue below, not the showcase — so a
   project can't appear twice on this page even if it's flagged featured. */
const inFlight = ['in-progress', 'loading'];

const featured = allProjects
  .filter((p) => p.data.featured && !inFlight.includes(p.data.status))
  .sort((a, b) => a.data.order - b.data.order)
---

<Layout title={`${site.name} — Full Stack Developer`}>
  <!-- ================= HERO ================= -->
  <section
    id="top"
    class="mx-auto grid max-w-[1180px] items-center px-10 pt-24 pb-20"
    style="grid-template-columns: repeat(auto-fit, minmax(min(330px, 100%), 1fr)); gap: 56px"
  >
    <div>
      <div class="mb-[26px] flex items-center gap-2.5">
        <div class="h-2.5 w-2.5 bg-green"></div>
        <span class="font-pixel text-[10px] tracking-[2px] text-green">PLAYER 01 &mdash; READY</span>
        <span
          data-caret
          class="h-4 w-[9px] bg-green"
          style="animation: hf-blink 1s steps(1, end) infinite"></span>
      </div>

      <h1
        class="m-0 mb-2 font-pixel leading-[1.5] text-text"
        style="font-size: clamp(22px, 3.4vw, 40px); text-shadow: 5px 5px 0 #1A2140"
      >
        Hi, I'm
      </h1>
      <h1
        class="m-0 mb-7 font-pixel leading-[1.5]"
        style="font-size: clamp(22px, 3.4vw, 40px); color: var(--accent); text-shadow: 5px 5px 0 #10203A"
      >
        {site.name}.
      </h1>

      <p class="m-0 mb-[26px] font-pixel text-[12px] tracking-[2px] text-yellow">{site.role}</p>

      <!-- TODO: replace with your own intro. Two or three sentences. -->
      <p
        class="m-0 mb-[38px] max-w-[52ch] text-[23px] leading-[1.5] text-text-muted"
        style="text-wrap: pretty"
      >
        Currently at Dacoda, building web applications end to end. Open to freelance work on the side, so reach out if you've got something worth building.
      </p>

      <div class="flex flex-wrap gap-[18px]">
        <Button href="#work" variant="primary">▶ START HERE</Button>
        <Button href="#contact" variant="secondary">GET IN TOUCH</Button>
      </div>
    </div>

    <!-- The cartridge panel, with a bleed glow behind it. -->
    <div class="relative">
      <div
        class="absolute"
        style="inset: -14px; background: linear-gradient(180deg, rgba(76,201,240,0.18), rgba(255,59,92,0.12))"
      >
      </div>
      <Panel
        label="AVATAR.PNG"
        labelColor="#7C86A8"
        meta="♥ ♥ ♥"
        background="#0E1326"
        shadow="12px 12px 0 rgba(0,0,0,0.6)"
        padding="16px"
        class="relative"
      >
        <div class="h-[340px] w-full">
          <PixelImage src={avatar} alt={`${site.name}, portrait`} pixel={9} priority />
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2.5">
          <StatTile value="5+" label="YEARS" color="var(--accent)" />
          <StatTile value="27 YEARS" label="UPTIME" color="#7CE04A" />
          <StatTile value="∞" label="BUGS SQUASHED" color="#FFC53D" valueClass="text-[32px]" />
        </div>
      </Panel>
    </div>
  </section>

  <ColorBar />

  <!-- ================= ABOUT ================= -->
  <section id="about" class="mx-auto max-w-[1180px] px-10 py-[84px]" data-reveal>
    <Eyebrow label="01 — ABOUT" class="mb-[30px]" />
    <div
      class="grid items-start"
      style="grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 48px"
    >
      <div>
        <h2
          class="m-0 mb-[26px] font-pixel leading-[1.7] text-text"
          style="font-size: clamp(16px, 2vw, 22px)"
        >
          Into computers<br />since I was young.<br />Still love it.
        </h2>
        <p
          class="m-0 mb-5 max-w-[58ch] text-[23px] leading-[1.55] text-text-muted"
          style="text-wrap: pretty"
        >
          I graduated from Reykjavík University with a degree in Computer Science.
          Since I was young I've been interested in computers and technology, which is
          what led me to study it. I've been working as a developer for over 3 years now.
        </p>
        <p class="m-0 max-w-[58ch] text-[23px] leading-[1.55] text-text-muted" style="text-wrap: pretty">
          I have a passion for building web applications and embracing new technologies. I like to think of myself as a quick learner and always looking for new challenges. 
          I've spent the last while getting deeper into the backend, learning Laravel and how to get the most out of it.
          The frontend has been a passion of mine for a long time though, because that's where the beauty lies.
        </p>
      </div>

      <Panel label="CHARACTER SHEET">
        <div class="grid gap-4">
          <!-- TODO: confirm each of these values. -->
          <SheetRow label="CLASS" value="FULL STACK DEV" />
          <SheetRow label="EDUCATION" value="B.Sc COMPUTER SCIENCE" />
          <SheetRow label="MAIN WEAPON" value="NEXT.JS" valueColor="var(--accent)" />
          <SheetRow label="OFF-HAND" value="LARAVEL" valueColor="#FF3B5C" />
          <SheetRow label="STATUS" value="OPEN TO WORK" valueColor="#7CE04A" last />
        </div>
      </Panel>
    </div>
  </section>

  <!-- ================= TOOLS BAND ================= -->
  <section id="stack" class="border-t-4 border-b-4 border-rule" style="background: #0B0F1F">
    <div
      class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-7 px-10 py-11"
    >
      <span class="font-pixel text-[10px] tracking-[3px] text-text-dim">TOOLS I REACH FOR</span>
      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-3">
        {tools.map((tool) => <Chip variant="tool">{tool}</Chip>)}
        <Button href="/uses" variant="primary" class="!py-4">SEE FULL INVENTORY ▶</Button>
      </div>
    </div>
  </section>

  <!-- ================= SELECTED WORK ================= -->
  <section id="work" class="mx-auto max-w-[1180px] px-10 py-[100px]">
    <Eyebrow label="02 — SELECT LEVEL" color="#7CE04A" class="mb-3.5" />
    <h2
      class="m-0 mb-5 font-pixel leading-[1.6] text-text"
      style="font-size: clamp(16px, 2vw, 22px)"
    >
      Selected work
    </h2>
    <p
      class="m-0 mb-12 max-w-[56ch] text-[23px] leading-[1.5] text-text-muted"
      style="text-wrap: pretty"
    >
      Projects that have been worked with closely with clients. Finding their problems and solving them.
    </p>

    <div class="grid gap-9">
      {
        featured.map((project, i) => (
          <ProjectCard project={project} imageSide={i % 2 === 0 ? 'left' : 'right'} />
        ))
      }
    </div>

    <div class="mt-12">
      <a href="/work" class="case-link" style="color: var(--accent)">SEE ALL PROJECTS ▶</a>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section id="contact" class="border-t-4 border-rule" style="background: #0B0F1F">
    <div class="mx-auto max-w-[1180px] px-10 pt-[90px] pb-[70px] text-center">
      <div class="mb-[26px] font-pixel text-[10px] tracking-[3px] text-text-dim">
        04 &mdash; CONTINUE?
      </div>
      <h2
        class="m-0 mb-[22px] font-pixel leading-[1.6] text-text"
        style="font-size: clamp(20px, 2.6vw, 30px); text-shadow: 5px 5px 0 #1A2140"
      >
        Got a level for<br />me to build?
      </h2>
      <p
        class="mx-auto m-0 mb-10 max-w-[46ch] text-[23px] leading-[1.5] text-text-muted"
        style="text-wrap: pretty"
      >
        Freelance work, or just a question about Laravel queues. The inbox is open.
      </p>
      <div class="mb-[52px] flex flex-wrap justify-center gap-[18px]">
        <Button href={`mailto:${site.email}`} variant="primary" class="!text-[12px] !px-[30px] !py-5">
          ✉ SAY HELLO
        </Button>
      </div>
      <div
        class="flex flex-wrap justify-center gap-x-[34px] gap-y-4 font-pixel text-[10px] tracking-[1px]"
      >
        {
          socials.map((s) => (
            <a
              href={s.href}
              class="social-link"
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
