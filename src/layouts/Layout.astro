---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/vt323/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BootScreen from '../components/BootScreen.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import ogImageDefault from '../assets/og-image.jpg';
import faviconLight from '../assets/logo/logo-light.svg';
import faviconDark from '../assets/logo/logo-dark.svg';

interface Props {
  title: string;
  description?: string;
  /** Which nav item is the current page. */
  current?: string;
  /** Case-study pages swap the nav for a single "back to work" link. */
  navVariant?: 'default' | 'case';
  /** The 404 paints its own overlays and pins its own header. */
  bare?: boolean;
  /** Set false to never boot on this page. The 404 must appear instantly —
   *  people arrive there from stale links, often as their first page, and the
   *  whole job of that page is to get them somewhere useful fast. */
  boot?: boolean;
  noindex?: boolean;
  /** Social card. Pages with their own art pass it in; everything else gets
   *  the site card. */
  image?: ImageMetadata;
}

const {
  title,
  description = site.description,
  current,
  navVariant = 'default',
  bare = false,
  boot = true,
  noindex = false,
  image = ogImageDefault,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image.src, Astro.site).href;

/* The boot log prints the real project count, so the line stays true as the
   collection grows. */
const projectCount = (await getCollection('projects')).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Firefox honours `media` here and re-picks live when the OS theme
        flips. Chrome ignores it and falls through to /favicon.svg, which
        carries the same swap in its own internal media query. Between the
        two every browser gets a theme-correct mark. */}
    <link rel="icon" type="image/svg+xml" href={faviconLight.src} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={faviconDark.src} media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Set both flags before first paint: `js` releases the scroll-reveal
         hidden state, and the scanline preference must not flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('scanlines') === 'off') {
          document.documentElement.dataset.scanlines = 'off';
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    {boot && <BootScreen projectCount={projectCount} />}

    <div class="relative min-h-screen">
      {
        !bare && (
          <>
            <div
              data-scanline-layer
              class="pointer-events-none absolute inset-0 z-50 mix-blend-multiply"
              style="background: repeating-linear-gradient(to bottom, rgba(0,0,0,0.22) 0px, rgba(0,0,0,0.22) 1px, transparent 1px, transparent 3px)"
            />
            <div
              class="pointer-events-none absolute inset-0 z-51"
              style="box-shadow: inset 0 0 220px rgba(0,0,0,0.85)"
            />
          </>
        )
      }

      {!bare && <Header current={current} variant={navVariant} />}

      <slot />

      {!bare && <Footer />}
    </div>

    <script>
      import '../scripts/retro-fx';
    </script>
  </body>
</html>

<style is:global>
  /* The scanline toggle. Static — never animate it. */
  html[data-scanlines='off'] [data-scanline-layer] {
    opacity: 0;
  }
</style>
