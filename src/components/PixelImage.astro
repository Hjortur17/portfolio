---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Block size in CSS px. 8 for screenshots, 9 for portraits — bigger blocks
   *  on faces, or they turn to mush. */
  pixel?: 8 | 9;
  widths?: number[];
  sizes?: string;
  /** Above-the-fold images (the hero portrait) must not lazy-load — it is the
   *  LCP element, and deferring it delays Largest Contentful Paint. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  pixel = 8,
  widths,
  sizes,
  priority = false,
  class: klass = '',
} = Astro.props;
---

<div
  class:list={['relative h-full w-full overflow-hidden', klass]}
  data-pixel={pixel}
  data-pixel-priority={priority ? '' : undefined}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="h-full w-full object-cover"
  />
</div>
