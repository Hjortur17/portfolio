---
import { nav, site } from '../data/site';
import ScanlineToggle from './ScanlineToggle.astro';
import logo from '../assets/logo/logo.svg';

interface Props {
  current?: string;
  variant?: 'default' | 'case';
  /** The 404 is not sticky — it can be served from any URL depth. */
  sticky?: boolean;
}

const { current, variant = 'default', sticky = true } = Astro.props;
---

<header
  class:list={[
    'flex items-center justify-between gap-6 border-b-4 border-rule px-10 py-[18px]',
    sticky ? 'sticky top-0 z-40' : 'relative z-20',
  ]}
  style="background: rgba(8,10,20,0.92)"
>
  <a href="/" class="flex shrink-0 items-center gap-3 text-text transition-opacity duration-[120ms] hover:opacity-75" style="transition-timing-function: steps(2)">
    <img src={logo.src} width="24" height="24" alt="" class="h-6 w-6" style="image-rendering: pixelated" />
    <span class="pl-3 font-pixel text-[11px] tracking-[1px] text-text">{site.wordmark}</span>
  </a>

  <div class="flex min-w-0 items-center gap-5">
    {
      variant === 'case' ? (
        <a href="/work" class="nav-link font-pixel text-[9px] tracking-[1px]">
          ◀ BACK TO WORK
        </a>
      ) : (
        <nav
          class="scrollbar-none flex min-w-0 items-center gap-7 overflow-x-auto font-pixel text-[9px] tracking-[1px]"
          aria-label="Main"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              class="nav-link shrink-0"
              data-primary={item.primary ? '' : undefined}
              aria-current={current === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
    <ScanlineToggle />
  </div>
</header>

<style>
  /* Mobile nav: a scrolling strip rather than a hamburger. No new visual
     language, no open/close state, no JS. The handoff left this undesigned. */
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
