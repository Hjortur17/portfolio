---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  [key: string]: any;
}
const { href, variant = 'primary', class: klass = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const cls = `${variant === 'primary' ? 'btn-primary' : 'btn-secondary'} ${klass}`;
---
<Tag href={href} class={cls} {...rest}><slot /></Tag>
