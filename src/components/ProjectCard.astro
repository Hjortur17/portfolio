---
import type { CollectionEntry } from 'astro:content';
import ProjectPlate from './ProjectPlate.astro';
import Badge from './Badge.astro';
import Chip from './Chip.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Cards alternate: image left, then right, then left. */
  imageSide: 'left' | 'right';
  /** The card title's level, so headings stay sequential wherever the card is
   *  used. On the homepage it sits under a section h2, so h3. On /work the
   *  page heading is the h1 directly above it, so h2 — an h3 there would skip
   *  a level and break the document outline. */
  headingLevel?: 2 | 3;
}

const { project, imageSide, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const d = project.data;

const levelColors = ['var(--accent)', '#FF3B5C', '#FFC53D', '#7CE04A', '#B98CFF'];
const levelColor = levelColors[(d.level - 1) % levelColors.length];

const statusLabel = {
  shipped: `SHIPPED — ${d.year}`,
  updated: `UPDATED — ${d.year}`,
  'loading': 'LOADING...',
} as const;
const statusTone = {
  shipped: '#7CE04A',
  updated: 'var(--accent)',
  'loading': '#FFC53D',
} as const;
const statusText = statusLabel[d.status];
const statusColor = statusTone[d.status];

/* Every project gets a case study, so the card always points inward with the
   same label. The live-site link lives on the project page, never out here.
   Link colour follows the level, matching the handoff's cards. */
const href = `/work/${project.id}`;
const linkLabel = 'READ THE CASE STUDY ▶';
const linkColor = levelColor;
---

<article
  class="card-lift grid border-4 border-border bg-surface"
  style="grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 0"
  data-reveal
>
  {/* Image and text meet at a shared 4px border, so the card has no gap.
      The plate is composed, not cropped: when the text column runs taller than
      4:3, the field grows around a still-centred window instead of slicing the
      screenshot the way object-cover on a flat image would. */}
  <div
    class:list={[
      imageSide === 'left'
        ? 'border-r-4 border-border'
        : 'order-last border-l-4 border-border',
    ]}
  >
    <ProjectPlate
      src={d.screenshot}
      alt={`${d.title} — ${d.domain}`}
      variant="cover"
      brand={d.brand}
      field={d.field}
      block={d.block}
      class="h-full w-full"
    />
  </div>

  <div class="flex flex-col justify-center px-9 py-[38px]">
    <div class="mb-5 flex flex-wrap items-center gap-3">
      <Badge color={levelColor}>LEVEL {String(d.level).padStart(2, '0')}</Badge>
      <span class="text-[19px] tracking-[1px]" style={`color: ${statusColor}`}>{statusText}</span>
    </div>

    <Heading
      class="m-0 mb-[18px] font-pixel leading-[1.6] text-text"
      style="font-size: clamp(15px, 1.6vw, 19px)"
    >
      {d.title}
    </Heading>

    <p class="m-0 mb-6 text-[22px] leading-[1.5] text-text-muted" style="text-wrap: pretty">
      {d.summary}
    </p>

    <div class="mb-[26px] flex flex-wrap gap-2.5">
      {d.tags.map((tag) => <Chip variant="tech">{tag}</Chip>)}
    </div>

    {
      href && (
        <a href={href} class="case-link" style={`color: ${linkColor}`}>
          {linkLabel}
        </a>
      )
    }
  </div>
</article>
