---
interface Props {
  n: number;
  title: string;
  body: string;
  color: string;
}
const { n, title, body, color } = Astro.props;
---
<div class="card-lift-sm border-4 border-border p-7" style="background: #141A2E">
  <div class="mb-5 font-pixel text-[22px]" style={`color: ${color}`}>
    {String(n).padStart(2, '0')}
  </div>
  <h3 class="m-0 mb-4 font-pixel text-[12px] leading-[1.6] text-text" set:html={title.replace(/\n/g, '<br />')} />
  <p class="m-0 text-[21px] leading-[1.45] text-text-muted" style="text-wrap: pretty">{body}</p>
</div>
